{
  "name": "pi-vim-editor",
  "description": "Minimal Vim-style modal editing for Pi's prompt editor that composes with other editor extensions.",
  "version": "0.7.0",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "vim",
    "modal-editing"
  ],
  "author": "Matthias Vallentin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavam/pi-vim-editor.git"
  },
  "homepage": "https://github.com/mavam/pi-vim-editor#readme",
  "bugs": {
    "url": "https://github.com/mavam/pi-vim-editor/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "format": "bunx @biomejs/biome format --write src tests demo/provider.ts",
    "format:check": "bunx @biomejs/biome format src tests demo/provider.ts",
    "lint": "bunx @biomejs/biome lint src tests demo/provider.ts",
    "lint:fix": "bunx @biomejs/biome lint --write src tests demo/provider.ts",
    "biome:check": "bunx @biomejs/biome check src tests demo/provider.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run biome:check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
